<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements" editor="UnityEditor.UIElements">

    <Style src="project://database/Packages/nox.cck/Resources/nox.style.uss?fileID=7433441132597879392&amp;guid=956d93e835714844b98277f4fdbd77d3&amp;type=3#nox.style" />
    <Style src="project://database/Packages/nox.loader/Resources/nox.cck.style.uss?fileID=7433441132597879392&amp;guid=ee18ab989d89a1a479332bd224e51c94&amp;type=3#nox.cck.style" />

    <!-- Summary: the backend in use and the number of IK targets the rig exposes.
         The elements carry a lang-key: their text is the language entry, the arguments come from the editor. -->
    <ui:VisualElement name="header" class="flex-col bg-secondary border m-8 p-4 rounded-md">
        <uie:LocalizedLabel name="label-backend" lang-key="rigging.inspector.backend_none" />
        <uie:LocalizedLabel name="label-targets" lang-key="rigging.inspector.targets" />
    </ui:VisualElement>

    <!-- No rig yet: the module resolves a backend when the avatar loads, and there is none to show before. -->
    <ui:VisualElement name="warning-no-rig" class="notification notification-warning m-8" style="display: none;">
        <ui:VisualElement name="icon" class="icon" />
        <uie:LocalizedLabel name="label-warning" class="label" lang-key="rigging.inspector.warning_no_rig" />
    </ui:VisualElement>

    <!-- IK targets the rig exposes, one row each (see RigManagerModuleEditor.Row.uxml).
         m-8 + foldout-flush: the foldout and its rows end on the same margins as the boxes above. -->
    <uie:LocalizedFoldout name="foldout-parts" class="foldout-flush m-8" lang-key="rigging.inspector.parts" value="true">
        <ui:VisualElement name="list-parts" class="flex-col" />
    </uie:LocalizedFoldout>

    <!-- Parameters the rig publishes on the avatar parameter module. -->
    <uie:LocalizedFoldout name="foldout-parameters" class="foldout-flush m-8" lang-key="rigging.inspector.parameters" value="true">
        <ui:VisualElement name="list-parameters" class="flex-col" />
    </uie:LocalizedFoldout>

    <!-- Backends registered in the rigging registry: the one in use is marked as active. -->
    <uie:LocalizedFoldout name="foldout-backends" class="foldout-flush m-8" lang-key="rigging.inspector.backends" value="true">
        <ui:VisualElement name="list-backends" class="flex-col" />
    </uie:LocalizedFoldout>

</ui:UXML>
