<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements" editor="UnityEditor.UIElements">

    <Style src="project://database/Packages/nox.cck/Resources/nox.style.uss?fileID=7433441132597879392&amp;guid=956d93e835714844b98277f4fdbd77d3&amp;type=3#nox.style" />
    <Style src="project://database/Packages/nox.loader/Resources/nox.cck.style.uss?fileID=7433441132597879392&amp;guid=ee18ab989d89a1a479332bd224e51c94&amp;type=3#nox.cck.style" />

    <!-- The head bone of the avatar: read from the rig, or detected from the animator with the button. -->
    <ui:VisualElement class="flex-row align-center gap-8 my-8">
        <uie:PropertyField name="headTransform" class="flex-grow" />
        <uie:LocalizedButton name="detect" lang-key="avatars.modules.camera.inspector.detect" />
    </ui:VisualElement>

    <!-- Offset added to the head bone, editable in the scene with a handle while « Edit » is on. -->
    <ui:VisualElement class="flex-row align-center gap-8">
        <uie:PropertyField name="cameraOffset" class="flex-grow" />
        <ui:Button name="edit" />
    </ui:VisualElement>

</ui:UXML>
