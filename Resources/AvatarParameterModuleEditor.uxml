<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/nox.avatars.modules/Resources/AvatarParameterModuleEditor.uss"/>
    <Style src="project://database/Packages/nox.cck/Resources/nox.style.uss?fileID=7433441132597879392&amp;guid=956d93e835714844b98277f4fdbd77d3&amp;type=3#nox.style" />
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="header" class="header">
            <ui:Label text="Avatar Parameter Module" name="header-label" class="header-label"/>
        </ui:VisualElement>

        <ui:VisualElement style="padding: 10px;">
